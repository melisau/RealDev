# RealDev on the VDS. Copy to .env.vds on the server (chmod 600) and fill in real values there.
# .env.vds is ignored by Git and Docker; never commit it. See docs/vds-deploy.md.

# --- Required ---------------------------------------------------------------
# Public HTTPS origin served by the shared Caddy proxy (no path, no trailing slash).
PUBLIC_ORIGIN=https://realdev.example.com
# Firebase Authentication (email/password). These browser config values are public.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key

# --- Optional: AI feedback and transcription --------------------------------
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# AI_DAILY_LIMIT=20

# --- Optional: Web Push reminders -------------------------------------------
# VAPID_SUBJECT must be an https: or mailto: contact for this deployment.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://realdev.example.com
# At least 32 characters; must match the GitHub secret REALDEV_REMINDER_DISPATCH_TOKEN.
# REMINDER_DISPATCH_TOKEN=
# Set to 1 only while the hourly dispatcher workflow targets this deployment.
# REMINDER_SCHEDULE_ENABLED=1

# --- Optional: code and project runners (separate host, HTTPS only) ---------
# PISTON_URL=https://runner.example.com
# PISTON_API_KEY=
# PROJECT_RUNNER_URL=https://projects.example.com
# PROJECT_RUNNER_API_KEY=

# --- Set by the image; override only if needed ------------------------------
# PORT=8080
# REALDEV_DB_FILE=/data/realdev.sqlite
